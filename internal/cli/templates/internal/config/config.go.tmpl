package config

import "os"

type Config struct {
	Port        string
	Environment string
	DatabaseURL string
}

func Load() Config {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	env := os.Getenv("APP_ENV")
	if env == "" {
		env = "development"
	}
	return Config{Port: port, Environment: env, DatabaseURL: os.Getenv("DATABASE_URL")}
}
