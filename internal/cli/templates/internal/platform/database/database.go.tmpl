package database

import (
	"context"
	"database/sql"
	"fmt"
	"time"

	"{{.Module}}/internal/platform/config"
{{if eq .Database "postgres"}}	_ "github.com/jackc/pgx/v5/stdlib"
{{else if eq .Database "sqlite"}}	_ "github.com/mattn/go-sqlite3"
{{else}}	_ "github.com/go-sql-driver/mysql"
{{end}}
{{if eq .ORM "gorm"}}	"gorm.io/gorm"
{{if eq .Database "postgres"}}	"gorm.io/driver/postgres"
{{else if eq .Database "sqlite"}}	"gorm.io/driver/sqlite"
{{else}}	"gorm.io/driver/mysql"
{{end}}{{else}}	"github.com/jmoiron/sqlx"
{{end}}
)

type Connection struct {
	SQL *sql.DB
{{if eq .ORM "gorm"}}	GORM *gorm.DB
{{else}}	SQLX *sqlx.DB
{{end}}
}

func Open(cfg config.Config) (*Connection, func(), error) {
	if cfg.DatabaseURL == "" && cfg.IsDevelopment() {
		cfg.DatabaseURL = "{{if eq .Database "sqlite"}}file:{{.Project}}.sqlite?_busy_timeout=5000{{else}}{{.Database}}://development:development@127.0.0.1/{{.Project}}{{end}}"
	}
	driver := "{{if eq .Database "postgres"}}pgx{{else if eq .Database "sqlite"}}sqlite3{{else}}mysql{{end}}"
	db, err := sql.Open(driver, cfg.DatabaseURL)
	if err != nil {
		return nil, nil, fmt.Errorf("open database: %w", err)
	}
	db.SetMaxOpenConns(10)
	db.SetMaxIdleConns(5)
	db.SetConnMaxLifetime(30 * time.Minute)
	cleanup := func() { _ = db.Close() }
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := db.PingContext(ctx); err != nil {
		cleanup()
		return nil, nil, fmt.Errorf("ping database: %w", err)
	}
	connection := &Connection{SQL: db}
{{if eq .ORM "gorm"}}	var dialector gorm.Dialector
{{if eq .Database "postgres"}}	dialector = postgres.New(postgres.Config{Conn: db})
{{else if eq .Database "sqlite"}}	dialector = sqlite.Dialector{Conn: db}
{{else}}	dialector = mysql.New(mysql.Config{Conn: db, SkipInitializeWithVersion: true})
{{end}}	gormDB, err := gorm.Open(dialector, &gorm.Config{})
	if err != nil {
		cleanup()
		return nil, nil, fmt.Errorf("initialize gorm: %w", err)
	}
	connection.GORM = gormDB
{{else}}	connection.SQLX = sqlx.NewDb(db, driver)
{{end}}	return connection, cleanup, nil
}
