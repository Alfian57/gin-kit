package config

import (
	"errors"
	"fmt"
	"net/url"
	"os"
	"strconv"
	"strings"
	"time"
)

type Config struct {
	Port               string
	Environment        string
	DatabaseURL        string
	JWTSecret          []byte
	SessionSecret      []byte
	TrustedProxyCIDRs  []string
	CORSAllowedOrigins []string
	RateLimitEnabled   bool
	RateLimits         RateLimitConfig
	MaxBodyBytes       int64
}

type RateLimitConfig struct {
	GeneralPerMinute  int
	AuthPerMinute     int
	ExpensivePerMinute int
}

func Load() (Config, error) {
	cfg := Config{
		Port:               value("PORT", "8080"),
		Environment:        value("APP_ENV", "development"),
		DatabaseURL:        os.Getenv("DATABASE_URL"),
		JWTSecret:          []byte(os.Getenv("JWT_SECRET")),
		SessionSecret:      []byte(os.Getenv("SESSION_SECRET")),
		TrustedProxyCIDRs:  split(os.Getenv("TRUSTED_PROXY_CIDRS")),
		CORSAllowedOrigins: split(os.Getenv("CORS_ALLOWED_ORIGINS")),
		RateLimitEnabled:   boolValue("RATE_LIMIT_ENABLED", true),
		RateLimits: RateLimitConfig{
			GeneralPerMinute:   intValue("RATE_LIMIT_GENERAL_PER_MINUTE", 60),
			AuthPerMinute:      intValue("RATE_LIMIT_AUTH_PER_MINUTE", 10),
			ExpensivePerMinute: intValue("RATE_LIMIT_EXPENSIVE_PER_MINUTE", 5),
		},
		MaxBodyBytes: int64(intValue("MAX_BODY_BYTES", 1<<20)),
	}
	if cfg.Environment == "production" || cfg.Environment == "staging" {
{{if .Auth}}
		if len(cfg.JWTSecret) < 32 {
			return Config{}, errors.New("JWT_SECRET must contain at least 32 bytes outside development")
		}
{{end}}
		if cfg.DatabaseURL == "" {
			return Config{}, errors.New("DATABASE_URL is required outside development")
		}
		if len(cfg.CORSAllowedOrigins) == 0 {
			return Config{}, errors.New("CORS_ALLOWED_ORIGINS is required outside development")
		}
	}
	if cfg.DatabaseURL != "" {
		if _, err := url.Parse(cfg.DatabaseURL); err != nil {
			return Config{}, fmt.Errorf("invalid DATABASE_URL: %w", err)
		}
	}
	if cfg.MaxBodyBytes <= 0 || cfg.RateLimits.GeneralPerMinute <= 0 || cfg.RateLimits.AuthPerMinute <= 0 || cfg.RateLimits.ExpensivePerMinute <= 0 {
		return Config{}, errors.New("body and rate-limit values must be positive")
	}
	return cfg, nil
}

func (c Config) IsDevelopment() bool { return c.Environment == "development" }
func (c Config) ShutdownTimeout() time.Duration { return 10 * time.Second }

func value(key, fallback string) string {
	if v := strings.TrimSpace(os.Getenv(key)); v != "" {
		return v
	}
	return fallback
}

func intValue(key string, fallback int) int {
	v, err := strconv.Atoi(os.Getenv(key))
	if err != nil || v <= 0 {
		return fallback
	}
	return v
}

func boolValue(key string, fallback bool) bool {
	v := strings.ToLower(strings.TrimSpace(os.Getenv(key)))
	if v == "" {
		return fallback
	}
	return v == "1" || v == "true" || v == "yes"
}

func split(value string) []string {
	var out []string
	for _, item := range strings.Split(value, ",") {
		if item = strings.TrimSpace(item); item != "" {
			out = append(out, item)
		}
	}
	return out
}
