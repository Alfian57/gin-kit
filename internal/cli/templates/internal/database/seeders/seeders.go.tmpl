// Package seeders registers this project's database seeders. gin-kit never
// edits this file; add generated seeders to All in the order they must run.
package seeders

import (
	"context"

{{if eq .ProjectType "runtime"}}	"github.com/Alfian57/gin-kit/runtime/database"
{{else}}	"{{.Module}}/internal/platform/database"
{{end}})

type Seeder struct {
	Name string
	// Run receives the full connection: db.SQL always, plus db.GORM or
	// db.SQLX per the project's ORM — so seeders can use repositories and
	// factories.
	Run func(context.Context, *database.Connection) error
}

// All lists every seeder in run order.
func All() []Seeder {
	return []Seeder{
{{if and .Example (eq .ProjectType "standalone")}}		{Name: "tasks", Run: SeedTasks},
{{end}}	}
}
