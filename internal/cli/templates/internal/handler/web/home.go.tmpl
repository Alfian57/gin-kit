package web

import (
	"github.com/gin-gonic/gin"
	"os"
	"path/filepath"
{{if .Auth}}	authhandler "{{.Module}}/internal/handler/auth"
	"{{.Module}}/internal/platform/config"
{{end}}{{if or .Auth .Example}}	"{{.Module}}/internal/platform/database"
{{end}})

func Register(r *gin.Engine{{if or .Auth .Example}}, db *database.Connection{{end}}{{if .Auth}}, cfg config.Config{{end}}) {
	if matches, _ := filepath.Glob("web/templates/*.html"); len(matches) > 0 {
		r.LoadHTMLGlob("web/templates/*.html")
	}
	r.Static("/assets", "web/assets")
	r.GET("/", func(c *gin.Context) {
		if _, err := os.Stat("web/templates/index.html"); err != nil {
			c.String(500, "UI templates are not available from this working directory")
			return
		}
		c.HTML(200, "index.html", gin.H{"project": "{{.Project}}", "module": "{{.Module}}"})
	})
{{if .Auth}}	authhandler.Register(r, db, cfg)
{{end}}{{if .Example}}	registerTasks(r, db)
{{end}}
}
