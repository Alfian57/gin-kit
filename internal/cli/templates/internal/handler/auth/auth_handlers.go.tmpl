// Package auth exposes the authentication endpoints: register, login,
// single-use refresh-token rotation, logout, and the protected /me route.
package auth

import (
	"errors"
	"net/http"
	"time"

	"github.com/gin-gonic/gin"
	"{{.Module}}/internal/domain"
	"{{.Module}}/internal/dto"
	"{{.Module}}/internal/middleware"
	"{{.Module}}/internal/platform/config"
	"{{.Module}}/internal/platform/database"
	"{{.Module}}/internal/platform/httpx"
	"{{.Module}}/internal/repository"
	"{{.Module}}/internal/service"
)

// Register wires the authentication routes onto the router.
func Register(r *gin.Engine, db *database.Connection, cfg config.Config) {
	accounts := service.NewAuthService(
		repository.NewUserRepository(db),
		repository.NewRefreshTokenRepository(db),
		cfg.JWTSecret,
		15*time.Minute,
		30*24*time.Hour,
	)
	registerRoutes(r, accounts, cfg.JWTSecret)
}

func registerRoutes(r *gin.Engine, accounts *service.AuthService, secret []byte) {
	group := r.Group("/api/v1/auth")
	group.POST("/register", func(c *gin.Context) {
		request, ok := httpx.BindJSON[dto.RegisterRequest](c)
		if !ok {
			return
		}
		user, pair, err := accounts.Register(c.Request.Context(), request.Email, request.Password)
		if err != nil {
			authError(c, err)
			return
		}
		httpx.Created(c, authResponse(user, pair))
	})
	group.POST("/login", func(c *gin.Context) {
		request, ok := httpx.BindJSON[dto.LoginRequest](c)
		if !ok {
			return
		}
		user, pair, err := accounts.Login(c.Request.Context(), request.Email, request.Password)
		if err != nil {
			authError(c, err)
			return
		}
		httpx.OK(c, authResponse(user, pair))
	})
	group.POST("/refresh", func(c *gin.Context) {
		request, ok := httpx.BindJSON[dto.RefreshRequest](c)
		if !ok {
			return
		}
		pair, err := accounts.Refresh(c.Request.Context(), request.RefreshToken)
		if err != nil {
			authError(c, err)
			return
		}
		httpx.OK(c, tokenResponse(pair))
	})
	group.POST("/logout", func(c *gin.Context) {
		request, ok := httpx.BindJSON[dto.RefreshRequest](c)
		if !ok {
			return
		}
		if err := accounts.Logout(c.Request.Context(), request.RefreshToken); err != nil {
			authError(c, err)
			return
		}
		httpx.NoContent(c)
	})

	protected := r.Group("/api/v1", middleware.RequireAuth(secret))
	protected.GET("/me", func(c *gin.Context) {
		user, err := accounts.User(c.Request.Context(), c.GetString("user_id"))
		if err != nil {
			authError(c, err)
			return
		}
		httpx.OK(c, dto.NewUserResponse(user))
	})
}

func tokenResponse(pair service.TokenPair) dto.TokenResponse {
	return dto.NewTokenResponse(pair.AccessToken, pair.RefreshToken, pair.TokenType, pair.ExpiresIn)
}

func authResponse(user domain.User, pair service.TokenPair) dto.AuthResponse {
	return dto.NewAuthResponse(user, tokenResponse(pair))
}

func authError(c *gin.Context, err error) {
	switch {
	case errors.Is(err, domain.ErrEmailTaken):
		httpx.Fail(c, httpx.NewError(http.StatusConflict, "email_taken", "This email address is already registered."))
	case errors.Is(err, service.ErrInvalidCredentials):
		httpx.Fail(c, httpx.NewError(http.StatusUnauthorized, "invalid_credentials", "The email or password is incorrect."))
	case errors.Is(err, service.ErrInvalidRefreshToken):
		httpx.Fail(c, httpx.NewError(http.StatusUnauthorized, "invalid_refresh_token", "The refresh token is invalid or expired."))
	case errors.Is(err, domain.ErrUserNotFound):
		httpx.Fail(c, httpx.NewError(http.StatusUnauthorized, "invalid_token", "Token is invalid or expired."))
	default:
		httpx.Fail(c, httpx.NewError(http.StatusInternalServerError, "internal_error", "An internal error occurred."))
	}
}
