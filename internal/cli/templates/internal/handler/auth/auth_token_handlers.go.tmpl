package auth

import (
	"errors"
	"net/http"

	"github.com/gin-gonic/gin"
	"{{.Module}}/internal/domain"
	"{{.Module}}/internal/dto"
	"{{.Module}}/internal/middleware"
	"{{.Module}}/internal/platform/httpx"
	"{{.Module}}/internal/service"
)

func registerTokenRoutes(r *gin.Engine, tokens *service.APITokenService, jwtSecret []byte) {
	group := r.Group("/api/v1/auth/tokens", middleware.RequireAuth(jwtSecret))
	group.POST("", func(c *gin.Context) {
		request, ok := httpx.BindJSON[dto.APITokenCreateRequest](c)
		if !ok {
			return
		}
		token, plaintext, err := tokens.Create(c.Request.Context(), c.GetString("user_id"), request)
		if err != nil {
			httpx.Fail(c, httpx.NewError(http.StatusInternalServerError, "internal_error", "An internal error occurred."))
			return
		}
		httpx.Created(c, dto.CreatedAPITokenResponse{APITokenResponse: dto.NewAPITokenResponse(token), Token: plaintext})
	})
	group.GET("", func(c *gin.Context) {
		list, err := tokens.List(c.Request.Context(), c.GetString("user_id"))
		if err != nil {
			httpx.Fail(c, httpx.NewError(http.StatusInternalServerError, "internal_error", "An internal error occurred."))
			return
		}
		response := make([]dto.APITokenResponse, 0, len(list))
		for _, token := range list {
			response = append(response, dto.NewAPITokenResponse(token))
		}
		httpx.OK(c, response)
	})
	group.DELETE("/:id", func(c *gin.Context) {
		err := tokens.Revoke(c.Request.Context(), c.GetString("user_id"), c.Param("id"))
		if errors.Is(err, domain.ErrAPITokenNotFound) {
			httpx.Fail(c, httpx.NewError(http.StatusNotFound, "token_not_found", "API token was not found."))
			return
		}
		if err != nil {
			httpx.Fail(c, httpx.NewError(http.StatusInternalServerError, "internal_error", "An internal error occurred."))
			return
		}
		httpx.NoContent(c)
	})
}
