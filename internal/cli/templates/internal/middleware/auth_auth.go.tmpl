package middleware

import (
	"net/http"
	"strings"

	"github.com/gin-gonic/gin"
	"{{.Module}}/internal/platform/auth"
	"{{.Module}}/internal/platform/httpx"
)

func RequireAuth(secret []byte) gin.HandlerFunc {
	return func(c *gin.Context) {
		header := c.GetHeader("Authorization")
		if !strings.HasPrefix(header, "Bearer ") {
			c.Header("WWW-Authenticate", "Bearer")
			httpx.Fail(c, httpx.NewError(http.StatusUnauthorized, "missing_token", "Bearer token required."))
			return
		}
		claims, err := auth.Parse(strings.TrimPrefix(header, "Bearer "), secret)
		if err != nil {
			c.Header("WWW-Authenticate", "Bearer")
			httpx.Fail(c, httpx.NewError(http.StatusUnauthorized, "invalid_token", "Token is invalid or expired."))
			return
		}
		c.Set("user_id", claims.UserID)
		c.Next()
	}
}

// RequireLogin accepts an OAuth browser session when present and otherwise
// requires the same Bearer token as RequireAuth.
func RequireLogin(secret []byte) gin.HandlerFunc {
	return func(c *gin.Context) {
		if c.GetString("user_id") != "" {
			c.Next()
			return
		}
		RequireAuth(secret)(c)
	}
}
