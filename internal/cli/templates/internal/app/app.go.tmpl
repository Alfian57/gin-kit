package app

import (
	"net/http"

	"github.com/gin-gonic/gin"
	"{{.Module}}/internal/config"
{{if eq .Mode "ui"}}	"{{.Module}}/internal/handler/web"
{{else}}	"{{.Module}}/internal/handler/api"
{{end}}
)

func New() (*gin.Engine, func(), error) {
	cfg := config.Load()
	_ = cfg
	r := gin.New()
	r.Use(gin.Logger(), gin.Recovery())
	r.GET("/health/live", func(c *gin.Context) { c.JSON(http.StatusOK, gin.H{"status": "ok"}) })
	r.GET("/health/ready", func(c *gin.Context) { c.JSON(http.StatusOK, gin.H{"status": "ready"}) })
{{if eq .Mode "ui"}}	web.Register(r)
{{else}}	api.Register(r)
{{end}}
	return r, func() {}, nil
}
