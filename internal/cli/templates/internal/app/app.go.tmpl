package app

import (
	"context"
{{if or (eq .Mode "ui") .OAuth}}	"crypto/rand"
	"errors"
{{end}}{{if .OAuth}}	"strings"
{{end}}	"net/http"
	"time"

	"github.com/gin-gonic/gin"
	"{{.Module}}/internal/middleware"
	"{{.Module}}/internal/platform/config"
	"{{.Module}}/internal/platform/database"
{{if .OAuth}}	platformauth "{{.Module}}/internal/platform/auth"
	"{{.Module}}/internal/platform/oauth"
{{end}}{{if or (eq .Mode "ui") .OAuth}}	"{{.Module}}/internal/platform/session"

{{end}}{{if eq .Mode "ui"}}
	"{{.Module}}/internal/handler/web"
{{else}}	"{{.Module}}/internal/handler/api"
{{end}}
)

func New() (*gin.Engine, func(), error) {
	cfg, err := config.Load()
	if err != nil {
		return nil, nil, err
	}
	db, dbCleanup, err := database.Open(cfg)
	if err != nil {
		return nil, nil, err
	}
	r := gin.New()
	if len(cfg.TrustedProxyCIDRs) == 0 {
		if err := r.SetTrustedProxies(nil); err != nil {
			dbCleanup()
			return nil, nil, err
		}
	} else if err := r.SetTrustedProxies(cfg.TrustedProxyCIDRs); err != nil {
		dbCleanup()
		return nil, nil, err
	}
	r.Use(gin.Logger(), gin.Recovery(), middleware.RequestID(), middleware.SecurityHeaders({{if eq .Mode "ui"}}true{{else}}false{{end}}), middleware.BodyLimit(cfg.MaxBodyBytes), middleware.CORS(cfg.CORSAllowedOrigins, cfg.IsDevelopment()))
	if cfg.RateLimitEnabled {
		limiter := middleware.NewRateLimiter(cfg.RateLimits.GeneralPerMinute, cfg.RateLimits.AuthPerMinute, cfg.RateLimits.ExpensivePerMinute)
		r.Use(limiter.Middleware(middleware.RateGeneral))
	}
{{if or (eq .Mode "ui") .OAuth}}	sessionSecret := cfg.SessionSecret
	if len(sessionSecret) == 0 {
		if !cfg.IsDevelopment() {
			dbCleanup()
			return nil, nil, errors.New("SESSION_SECRET is required outside development")
		}
		sessionSecret = make([]byte, session.MinimumSecretLength)
		if _, err := rand.Read(sessionSecret); err != nil {
			dbCleanup()
			return nil, nil, err
		}
	}
	sessionMiddleware, err := session.Middleware(session.Options{
		Secret: sessionSecret,
		Secure: !cfg.IsDevelopment(),
	})
	if err != nil {
		dbCleanup()
		return nil, nil, err
	}
	{{if .OAuth}}r.Use(sessionMiddleware, platformauth.SessionMiddleware(), session.CSRF(session.CSRFOptions{Skipper: func(c *gin.Context) bool {
		return strings.HasPrefix(c.Request.URL.Path, "/api/") && (c.GetString("user_id") == "" || c.GetHeader("Authorization") != "")
	}}))
	{{else}}r.Use(sessionMiddleware, session.CSRF(session.CSRFOptions{}))
	{{end}}
{{end}}
	r.GET("/health/live", func(c *gin.Context) { c.JSON(http.StatusOK, gin.H{"status": "ok"}) })
	r.GET("/health/ready", func(c *gin.Context) {
		ctx, cancel := context.WithTimeout(c.Request.Context(), 2*time.Second)
		defer cancel()
		if err := db.SQL.PingContext(ctx); err != nil {
			c.JSON(http.StatusServiceUnavailable, gin.H{"status": "not_ready"})
			return
		}
		c.JSON(http.StatusOK, gin.H{"status": "ready"})
	})
{{if .OAuth}}	providers := []oauth.Provider{}
	if cfg.OAuth.Google.ClientID != "" {
		provider, err := oauth.NewGoogle(context.Background(), oauth.Config{ClientID: cfg.OAuth.Google.ClientID, ClientSecret: cfg.OAuth.Google.ClientSecret, RedirectURL: cfg.OAuth.Google.RedirectURL})
		if err != nil { dbCleanup(); return nil, nil, err }
		providers = append(providers, provider)
	}
	if cfg.OAuth.GitHub.ClientID != "" {
		provider, err := oauth.NewGitHub(oauth.Config{ClientID: cfg.OAuth.GitHub.ClientID, ClientSecret: cfg.OAuth.GitHub.ClientSecret, RedirectURL: cfg.OAuth.GitHub.RedirectURL})
		if err != nil { dbCleanup(); return nil, nil, err }
		providers = append(providers, provider)
	}
	oauthManager, err := oauth.NewManager(providers...)
	if err != nil { dbCleanup(); return nil, nil, err }
{{end}}
{{if eq .Mode "ui"}}	web.Register(r{{if or .Auth .Example}}, db{{end}}{{if .Auth}}, cfg{{end}}{{if .OAuth}}, oauthManager, cfg.OAuth.SuccessRedirect, cfg.OAuth.FailureRedirect{{end}})
{{else}}	api.Register(r{{if or .Auth .Example}}, db{{end}}{{if .Auth}}, cfg{{end}}{{if .OAuth}}, oauthManager, cfg.OAuth.SuccessRedirect, cfg.OAuth.FailureRedirect{{end}})
{{end}}
	cleanup := func() { dbCleanup() }
	return r, cleanup, nil
}
