package service

import (
	"context"
	"errors"
	"strings"
	"sync"
	"testing"
	"time"

	jwtauth "github.com/Alfian57/gin-kit/runtime/auth"
	"github.com/Alfian57/gin-kit/runtime/password"
	"{{.Module}}/internal/domain"
)

type memoryUsers struct {
	mu    sync.Mutex
	users map[string]domain.User
}

func (m *memoryUsers) Create(_ context.Context, user *domain.User) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	for _, existing := range m.users {
		if existing.Email == user.Email {
			return domain.ErrEmailTaken
		}
	}
	m.users[user.ID] = *user
	return nil
}

func (m *memoryUsers) FindByEmail(_ context.Context, email string) (domain.User, error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	for _, user := range m.users {
		if user.Email == email {
			return user, nil
		}
	}
	return domain.User{}, domain.ErrUserNotFound
}

func (m *memoryUsers) FindByID(_ context.Context, id string) (domain.User, error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	user, ok := m.users[id]
	if !ok {
		return domain.User{}, domain.ErrUserNotFound
	}
	return user, nil
}

type memoryRefresh struct {
	mu     sync.Mutex
	tokens map[string]domain.RefreshToken
}

func (m *memoryRefresh) Store(_ context.Context, token *domain.RefreshToken) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.tokens[token.TokenHash] = *token
	return nil
}

func (m *memoryRefresh) FindByHash(_ context.Context, hash string) (domain.RefreshToken, error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	token, ok := m.tokens[hash]
	if !ok {
		return domain.RefreshToken{}, domain.ErrRefreshTokenNotFound
	}
	return token, nil
}

func (m *memoryRefresh) DeleteByHash(_ context.Context, hash string) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	delete(m.tokens, hash)
	return nil
}

func (m *memoryRefresh) DeleteForUser(_ context.Context, userID string) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	for hash, token := range m.tokens {
		if token.UserID == userID {
			delete(m.tokens, hash)
		}
	}
	return nil
}

{{if .OAuth}}type memoryOAuthIdentities struct {
	mu         sync.Mutex
	identities map[string]domain.OAuthIdentity
}

func (m *memoryOAuthIdentities) Create(_ context.Context, identity *domain.OAuthIdentity) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	key := identity.Provider + ":" + identity.ProviderSubject
	if _, exists := m.identities[key]; exists {
		return domain.ErrOAuthIdentityTaken
	}
	m.identities[key] = *identity
	return nil
}

func (m *memoryOAuthIdentities) FindByProviderSubject(_ context.Context, provider, subject string) (domain.OAuthIdentity, error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	identity, ok := m.identities[provider+":"+subject]
	if !ok {
		return domain.OAuthIdentity{}, domain.ErrOAuthIdentityNotFound
	}
	return identity, nil
}

{{end}}func testAuthService(t *testing.T, refreshTTL time.Duration) (*AuthService, *memoryRefresh) {
	t.Helper()
	tokens, err := jwtauth.New([]byte(strings.Repeat("s", jwtauth.MinimumSecretLength)), "{{.Project}}", 15*time.Minute)
	if err != nil {
		t.Fatal(err)
	}
	refresh := &memoryRefresh{tokens: map[string]domain.RefreshToken{}}
	return NewAuthService(&memoryUsers{users: map[string]domain.User{}}, refresh,{{if .OAuth}} &memoryOAuthIdentities{identities: map[string]domain.OAuthIdentity{}},{{end}} tokens, refreshTTL), refresh
}

func TestRegisterStoresVerifiableHashAndNormalizesEmail(t *testing.T) {
	ctx := context.Background()
	accounts, _ := testAuthService(t, time.Hour)
	user, pair, err := accounts.Register(ctx, "  USER@Example.com ", "super-secret-1")
	if err != nil {
		t.Fatal(err)
	}
	if user.Email != "user@example.com" {
		t.Fatalf("email not normalized: %q", user.Email)
	}
	if user.PasswordHash == nil || !password.Compare("super-secret-1", *user.PasswordHash) {
		t.Fatal("stored hash does not verify")
	}
	if pair.AccessToken == "" || pair.RefreshToken == "" || pair.TokenType != "Bearer" || pair.ExpiresIn != 900 {
		t.Fatalf("token pair incomplete: %+v", pair)
	}
	if _, _, err := accounts.Register(ctx, "user@example.com", "another-secret-1"); !errors.Is(err, domain.ErrEmailTaken) {
		t.Fatalf("duplicate email accepted: %v", err)
	}
}

func TestLoginRejectsBadCredentials(t *testing.T) {
	ctx := context.Background()
	accounts, _ := testAuthService(t, time.Hour)
	if _, _, err := accounts.Register(ctx, "user@example.com", "super-secret-1"); err != nil {
		t.Fatal(err)
	}
	if _, _, err := accounts.Login(ctx, "user@example.com", "wrong-password"); !errors.Is(err, ErrInvalidCredentials) {
		t.Fatalf("wrong password: %v", err)
	}
	if _, _, err := accounts.Login(ctx, "ghost@example.com", "whatever-secret"); !errors.Is(err, ErrInvalidCredentials) {
		t.Fatalf("unknown account: %v", err)
	}
	if _, _, err := accounts.Login(ctx, "user@example.com", "super-secret-1"); err != nil {
		t.Fatal(err)
	}
}

func TestRefreshRotatesAndRejectsExpiredTokens(t *testing.T) {
	ctx := context.Background()
	accounts, refresh := testAuthService(t, time.Hour)
	_, pair, err := accounts.Register(ctx, "user@example.com", "super-secret-1")
	if err != nil {
		t.Fatal(err)
	}
	rotated, err := accounts.Refresh(ctx, pair.RefreshToken)
	if err != nil || rotated.RefreshToken == pair.RefreshToken {
		t.Fatalf("rotation failed: %+v err=%v", rotated, err)
	}
	if _, err := accounts.Refresh(ctx, pair.RefreshToken); !errors.Is(err, ErrInvalidRefreshToken) {
		t.Fatalf("used token accepted: %v", err)
	}

	// Force-expire the current token and verify rejection.
	hash := jwtauth.HashRefreshToken(rotated.RefreshToken)
	refresh.mu.Lock()
	expired := refresh.tokens[hash]
	expired.ExpiresAt = time.Now().UTC().Add(-time.Minute)
	refresh.tokens[hash] = expired
	refresh.mu.Unlock()
	if _, err := accounts.Refresh(ctx, rotated.RefreshToken); !errors.Is(err, ErrInvalidRefreshToken) {
		t.Fatalf("expired token accepted: %v", err)
	}
}

func TestLogoutIsIdempotent(t *testing.T) {
	ctx := context.Background()
	accounts, _ := testAuthService(t, time.Hour)
	_, pair, err := accounts.Register(ctx, "user@example.com", "super-secret-1")
	if err != nil {
		t.Fatal(err)
	}
	if err := accounts.Logout(ctx, pair.RefreshToken); err != nil {
		t.Fatal(err)
	}
	if err := accounts.Logout(ctx, pair.RefreshToken); err != nil {
		t.Fatal("second logout errored")
	}
	if _, err := accounts.Refresh(ctx, pair.RefreshToken); !errors.Is(err, ErrInvalidRefreshToken) {
		t.Fatalf("refresh after logout accepted: %v", err)
	}
}
