package api

import (
	"net/http"
	"strings"

	"github.com/Alfian57/gin-kit/runtime/httpx"
	"github.com/Alfian57/gin-kit/runtime/openapi"
	"github.com/Alfian57/gin-kit/runtime/query"
	"github.com/gin-gonic/gin"
	"{{.Module}}/internal/dto"
)

// sampleTasks stands in for your repository; replace it with a service backed
// by the application database.
var sampleTasks = []dto.TaskResponse{
	{ID: "1", Title: "Write the report", Completed: true},
	{ID: "2", Title: "Review the report", Completed: false},
	{ID: "3", Title: "Ship the release", Completed: false},
}

func registerTasks(router *gin.Engine, docs *openapi.Registry) {
	docs.Describe(
		openapi.Operation{
			Method: http.MethodPost, Path: "/api/v1/tasks",
			Summary: "Create a task", Tags: []string{"tasks"},
			Request: dto.CreateTaskRequest{}, Response: dto.TaskResponse{}, Status: http.StatusCreated,
		},
		openapi.Operation{
			Method: http.MethodGet, Path: "/api/v1/tasks",
			Summary: "List tasks", Tags: []string{"tasks"},
			Response: dto.TaskResponse{}, List: true,
			Filters: []string{"completed", "title"},
			Sorts:   []string{"id", "title"},
		},
	)
	router.POST("/api/v1/tasks", func(c *gin.Context) {
		request, ok := httpx.BindJSON[dto.CreateTaskRequest](c)
		if !ok {
			return
		}
		httpx.Created(c, dto.TaskResponse{ID: "example", Title: request.Title, Completed: false})
	})
	router.GET("/api/v1/tasks", func(c *gin.Context) {
		result, err := query.Parse(c, query.Options{
			AllowedFilters: []query.Filter{query.Exact("completed").Bool(), query.Partial("title")},
			AllowedSorts:   []query.Sort{query.SortBy("id"), query.SortBy("title")},
			DefaultSort:    "id",
		})
		if err != nil {
			httpx.Handle(c, nil, err)
			return
		}
		// In-memory filtering demonstrates the parsed query; with a database,
		// use result.ApplyGORM or result.BuildSQL instead.
		items := make([]dto.TaskResponse, 0, len(sampleTasks))
		for _, item := range sampleTasks {
			if matches(item, result.Filters) {
				items = append(items, item)
			}
		}
		httpx.List(c, items, result.Meta(int64(len(items))))
	})
}

func matches(item dto.TaskResponse, filters []query.FilterValue) bool {
	for _, filter := range filters {
		switch filter.Name {
		case "completed":
			if (filter.Values[0] == "true") != item.Completed {
				return false
			}
		case "title":
			if !strings.Contains(strings.ToLower(item.Title), strings.ToLower(filter.Values[0])) {
				return false
			}
		}
	}
	return true
}
