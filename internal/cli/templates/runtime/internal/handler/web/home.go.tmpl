package web

import (
	"net/http"
	"os"

	"github.com/Alfian57/gin-kit/runtime/openapi"
	"github.com/gin-gonic/gin"
{{if .Auth}}
	jwtauth "github.com/Alfian57/gin-kit/runtime/auth"
	{{if .OAuth}}socialoauth "github.com/Alfian57/gin-kit/runtime/oauth"
	{{end}}	authhandler "{{.Module}}/internal/handler/auth"
	authhandler "{{.Module}}/internal/handler/auth"
	"{{.Module}}/internal/service"
{{end}}
)

// Register installs the initial application-owned UI routes.
func Register(router *gin.Engine, docs *openapi.Registry{{if .Auth}}, tokens *jwtauth.Manager, accounts *service.AuthService, apiTokens *service.APITokenService{{end}}{{if .OAuth}}, oauthManager *socialoauth.Manager, successRedirect, failureRedirect string{{end}}) {
	_ = docs
{{if .Auth}}	authhandler.Register(router, docs, tokens, accounts)
	authhandler.RegisterTokens(router, docs, tokens, apiTokens)
{{if .OAuth}}	authhandler.RegisterOAuth(router, docs, accounts, oauthManager, successRedirect, failureRedirect)
{{end}}
{{end}}{{if .Example}}	registerTasks(router)
{{end}}	if _, err := os.Stat("web/templates/index.html"); err == nil {
		router.LoadHTMLGlob("web/templates/*.html")
		router.Static("/assets", "web/assets")
		router.GET("/", func(c *gin.Context) {
			c.HTML(http.StatusOK, "index.html", gin.H{"project": "{{.Project}}"})
		})
		return
	}
	router.GET("/", func(c *gin.Context) {
		c.String(http.StatusOK, "Welcome to {{.Project}}")
	})
}
