package app

import (
{{if or .Auth (ne .Database "sqlite")}}	"fmt"
{{end}}	"os"
	"strings"
{{if .Auth}}	"time"
{{end}}
	"github.com/Alfian57/gin-kit/framework"
{{if .Auth}}	"github.com/Alfian57/gin-kit/framework/auth"
{{end}}	"github.com/Alfian57/gin-kit/framework/database"
	"github.com/gin-gonic/gin"

{{if eq .Mode "ui"}}	"{{.Module}}/internal/handler/web"
{{else}}	"{{.Module}}/internal/handler/api"
{{end}}
)

// New composes the opinionated gin-kit runtime. Application behavior remains
// in this project: add routes and middleware through Configure.
func New() (*framework.Application, error) {
	dsn := os.Getenv("DATABASE_URL")
	if dsn == "" {
{{if eq .Database "sqlite"}}		dsn = "file:{{.Project}}.sqlite?_busy_timeout=5000"
{{else}}		return nil, fmt.Errorf("DATABASE_URL is required for {{.Database}}")
{{end}}	}
	connectionConfig := database.Config{
		Dialect: database.{{if eq .Database "postgres"}}Postgres{{else if eq .Database "sqlite"}}SQLite{{else if eq .Database "mariadb"}}MariaDB{{else}}MySQL{{end}},
		DSN:     dsn,
		ORM:     database.{{if eq .ORM "gorm"}}GORM{{else}}SQLX{{end}},
	}
	application, err := framework.New(framework.Options{
		HTTP: framework.HTTPOptions{
			Address: env("PORT", ":8080"),
			UI:      {{if eq .Mode "ui"}}true{{else}}false{{end}},
			// Forwarded client addresses are honored only from these proxies.
			TrustedProxies: splitCSV(os.Getenv("TRUSTED_PROXY_CIDRS")),
		},
		Database: &connectionConfig,
	})
	if err != nil {
		return nil, err
	}
{{if .Auth}}	tokens, err := auth.New([]byte(os.Getenv("JWT_SECRET")), "{{.Project}}", 15*time.Minute)
	if err != nil {
		return nil, fmt.Errorf("JWT_SECRET: %w", err)
	}
{{end}}	var router *gin.Engine = application.Router()
{{if eq .Mode "ui"}}	web.Register(router{{if .Auth}}, tokens{{end}})
{{else}}	api.Register(router{{if .Auth}}, tokens{{end}})
{{end}}
	return application, nil
}

func env(key, fallback string) string {
	if value := os.Getenv(key); value != "" {
		if key == "PORT" && value[0] != ':' {
			return ":" + value
		}
		return value
	}
	return fallback
}

func splitCSV(value string) []string {
	var items []string
	for _, item := range strings.Split(value, ",") {
		if trimmed := strings.TrimSpace(item); trimmed != "" {
			items = append(items, trimmed)
		}
	}
	return items
}
