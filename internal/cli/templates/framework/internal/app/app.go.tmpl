package app

import (
{{if or .Auth (ne .Database "sqlite")}}	"fmt"
{{end}}{{if .Auth}}	"time"
{{end}}
	"github.com/Alfian57/gin-kit/framework"
{{if .Auth}}	"github.com/Alfian57/gin-kit/framework/auth"
{{end}}	"github.com/Alfian57/gin-kit/framework/config"
	"github.com/Alfian57/gin-kit/framework/database"
	"github.com/gin-gonic/gin"

{{if eq .Mode "ui"}}	"{{.Module}}/internal/handler/web"
{{else}}	"{{.Module}}/internal/handler/api"
{{end}}	"{{.Module}}/internal/jobs"
{{if .Auth}}	"{{.Module}}/internal/repository"
	"{{.Module}}/internal/service"
{{end}})

// New composes the opinionated gin-kit runtime. Application behavior remains
// in this project: add routes and middleware through Configure.
func New() (*framework.Application, error) {
	if err := config.LoadDotenv(".env"); err != nil {
		return nil, err
	}
	cfg, err := config.Load()
	if err != nil {
		return nil, err
	}
	dsn := cfg.DatabaseURL
	if dsn == "" {
{{if eq .Database "sqlite"}}		dsn = "file:{{.Project}}.sqlite?_busy_timeout=5000"
{{else}}		return nil, fmt.Errorf("DATABASE_URL is required for {{.Database}}")
{{end}}	}
	connectionConfig := database.Config{
		Dialect: database.{{if eq .Database "postgres"}}Postgres{{else if eq .Database "sqlite"}}SQLite{{else if eq .Database "mariadb"}}MariaDB{{else}}MySQL{{end}},
		DSN:     dsn,
		ORM:     database.{{if eq .ORM "gorm"}}GORM{{else}}SQLX{{end}},
	}
	options := cfg.Options()
	options.HTTP.UI = {{if eq .Mode "ui"}}true{{else}}false{{end}}
	options.Database = &connectionConfig
	application, err := framework.New(options)
	if err != nil {
		return nil, err
	}
{{if .Auth}}	tokens, err := auth.New(cfg.JWTSecret, "{{.Project}}", 15*time.Minute)
	if err != nil {
		return nil, fmt.Errorf("JWT_SECRET: %w", err)
	}
	accounts := service.NewAuthService(
		repository.NewUserRepository(application.Database()),
		repository.NewRefreshTokenRepository(application.Database()),
		tokens,
		30*24*time.Hour,
	)
{{end}}	jobs.Register(application.Queue(), application.Logger())
	var router *gin.Engine = application.Router()
{{if eq .Mode "ui"}}	web.Register(router{{if .Auth}}, tokens, accounts{{end}})
{{else}}	api.Register(router{{if .Auth}}, tokens, accounts{{end}})
{{end}}
	return application, nil
}
