// Package jobs holds this project's background job handlers. Handlers are
// registered explicitly in Register and dispatched with queue.Dispatch.
package jobs

import (
	"context"
	"log/slog"

	"github.com/Alfian57/gin-kit/framework/queue"
)

// TypePing names the example job. Dispatch it with:
//
//	queue.Dispatch(ctx, q, jobs.TypePing, jobs.PingPayload{Message: "hello"})
const TypePing = "example.ping"

type PingPayload struct {
	Message string `json:"message"`
}

// Register wires this project's job handlers onto the queue. Call it before
// the application runs; QUEUE_DRIVER=redis processes jobs on a supervised
// worker, while the default sync driver executes them inline.
func Register(q *queue.Queue, logger *slog.Logger) {
	queue.Register(q, TypePing, func(ctx context.Context, payload PingPayload) error {
		logger.InfoContext(ctx, "ping job handled", "message", payload.Message)
		return nil
	})
}
