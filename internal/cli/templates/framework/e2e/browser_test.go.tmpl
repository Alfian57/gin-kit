// Package e2e contains browser tests driven by Playwright. They skip
// automatically when the Playwright driver or browsers are not installed;
// set them up once with:
//
//	go run github.com/playwright-community/playwright-go/cmd/playwright@latest install --with-deps chromium
package e2e

import (
	"testing"

	"github.com/Alfian57/gin-kit/framework/browsertest"
	"github.com/playwright-community/playwright-go"
	"{{.Module}}/internal/app"
)

func TestHomePageRenders(t *testing.T) {
	browser := browsertest.Launch(t)
	application, err := app.New()
	if err != nil {
		t.Fatal(err)
	}
	base := browsertest.StartServer(t, application)

	page := browser.NewPage(t)
	if _, err := page.Goto(base + "/"); err != nil {
		t.Fatal(err)
	}
	heading := page.Locator("h1").First()
	if err := heading.WaitFor(playwright.LocatorWaitForOptions{Timeout: playwright.Float(10000)}); err != nil {
		t.Fatalf("no heading rendered: %v", err)
	}
	text, err := heading.TextContent()
	if err != nil || text == "" {
		t.Fatalf("empty heading: %q err=%v", text, err)
	}
}
{{if .Example}}
func TestTasksFormRoundTrip(t *testing.T) {
	browser := browsertest.Launch(t)
	application, err := app.New()
	if err != nil {
		t.Fatal(err)
	}
	base := browsertest.StartServer(t, application)

	page := browser.NewPage(t)
	if _, err := page.Goto(base + "/tasks"); err != nil {
		t.Fatal(err)
	}
	title := "Browser test task"
	if err := page.Locator("input[name=title]").Fill(title); err != nil {
		t.Fatal(err)
	}
	// Submitting through the real browser carries the session cookie and the
	// hidden CSRF field.
	if err := page.Locator("form button[type=submit]").Click(); err != nil {
		t.Fatal(err)
	}
	if err := page.Locator("text=" + title).First().WaitFor(playwright.LocatorWaitForOptions{Timeout: playwright.Float(10000)}); err != nil {
		t.Fatalf("submitted task not visible: %v", err)
	}
}
