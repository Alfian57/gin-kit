package main

import (
	"context"
	"log"

	"{{.Module}}/internal/database/seeders"
	"{{.Module}}/internal/platform/config"
	"{{.Module}}/internal/platform/database"
)

func main() {
	if err := config.LoadDotenv(".env"); err != nil {
		log.Fatal(err)
	}
	cfg, err := config.Load()
	if err != nil {
		log.Fatal(err)
	}
	db, cleanup, err := database.Open(cfg)
	if err != nil {
		log.Fatal(err)
	}
	defer cleanup()

	ctx := context.Background()
	for _, seeder := range seeders.All() {
		log.Printf("seeding %s", seeder.Name)
		if err := seeder.Run(ctx, db); err != nil {
			log.Fatalf("seeder %s: %v", seeder.Name, err)
		}
	}
	log.Println("seeding complete")
}
