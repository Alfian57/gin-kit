func New{{.Name}}Factory() *factory.Factory[domain.{{.Name}}] {
	return factory.Define(func(f *factory.F) domain.{{.Name}} {
		now := time.Now().UTC()
		return domain.{{.Name}}{
			ID:        f.UUID(),
{{range .Fields}}			{{.Pascal}}: {{if .Nullable}}ptr({{.FakeExpr}}){{else}}{{.FakeExpr}}{{end}},
{{end}}			CreatedAt: now,
			UpdatedAt: now,
		}
	})
}
{{if .HasNullable}}
func ptr[T any](value T) *T { return &value }
