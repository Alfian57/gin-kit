package repository

import (
	"context"
	"errors"
	"testing"

	"github.com/Alfian57/gin-kit/framework/apptest"
	"github.com/Alfian57/gin-kit/framework/database"
	"github.com/Alfian57/gin-kit/framework/query"
	"{{.Module}}/internal/database/factories"
	"{{.Module}}/internal/domain"
)

// Test{{.Name}}RepositoryIntegration exercises the real repository against an
// in-memory SQLite database.
func Test{{.Name}}RepositoryIntegration(t *testing.T) {
	ctx := context.Background()
	connection := apptest.OpenSQLite(t, database.{{if eq .ORM "gorm"}}GORM{{else}}SQLX{{end}})
	if _, err := connection.SQL.ExecContext(ctx, `{{.SQLiteSchema}}`); err != nil {
		t.Fatal(err)
	}
	repo := New{{.Name}}Repository(connection)
	factory := factories.New{{.Name}}Factory()

	created, err := factory.Create(ctx, repo.Create)
	if err != nil {
		t.Fatal(err)
	}

	fetched, err := repo.Get(ctx, created.ID)
	if err != nil || fetched.ID != created.ID {
		t.Fatalf("get: %+v err=%v", fetched, err)
	}

	if _, err := factory.CreateMany(ctx, 3, repo.Create); err != nil {
		t.Fatal(err)
	}
	items, total, err := repo.List(ctx, query.Result{Page: 1, PerPage: 2, Sorts: []query.SortValue{{"{{"}}Column: "created_at", Desc: true{{"}}"}}})
	if err != nil {
		t.Fatal(err)
	}
	if total != 4 || len(items) != 2 {
		t.Fatalf("list: total=%d page=%d", total, len(items))
	}

	fetched.UpdatedAt = fetched.UpdatedAt.Add(0)
	if err := repo.Update(ctx, &fetched); err != nil {
		t.Fatalf("update: %v", err)
	}

	if err := repo.Delete(ctx, created.ID); err != nil {
		t.Fatal(err)
	}
	if _, err := repo.Get(ctx, created.ID); !errors.Is(err, domain.Err{{.Name}}NotFound) {
		t.Fatalf("deleted entity still found: %v", err)
	}
	if err := repo.Delete(ctx, created.ID); !errors.Is(err, domain.Err{{.Name}}NotFound) {
		t.Fatalf("double delete: %v", err)
	}
}
