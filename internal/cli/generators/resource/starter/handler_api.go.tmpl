func {{.Camel}}Error(c *gin.Context, err error) {
	switch {
	case errors.Is(err, domain.Err{{.Name}}NotFound):
		httpx.Fail(c, httpx.NewError(http.StatusNotFound, "{{.Snake}}_not_found", "{{.Name}} not found."))
	case errors.Is(err, service.ErrInvalid{{.Name}}):
