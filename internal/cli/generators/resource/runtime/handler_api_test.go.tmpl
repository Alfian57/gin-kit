type fake{{.Name}}Repository struct {
	mu    sync.Mutex
	items map[string]domain.{{.Name}}
}

func (f *fake{{.Name}}Repository) Create(_ context.Context, entity *domain.{{.Name}}) error {
	f.mu.Lock()
	defer f.mu.Unlock()
	f.items[entity.ID] = *entity
	return nil
}

func (f *fake{{.Name}}Repository) List(_ context.Context, _ query.Result) ([]domain.{{.Name}}, int64, error) {
	f.mu.Lock()
	defer f.mu.Unlock()
	items := make([]domain.{{.Name}}, 0, len(f.items))
	for _, item := range f.items {
		items = append(items, item)
	}
	return items, int64(len(items)), nil
}

func (f *fake{{.Name}}Repository) Get(_ context.Context, id string) (domain.{{.Name}}, error) {
	f.mu.Lock()
	defer f.mu.Unlock()
	item, ok := f.items[id]
	if !ok {
		return domain.{{.Name}}{}, domain.Err{{.Name}}NotFound
	}
	return item, nil
}

func (f *fake{{.Name}}Repository) Update(_ context.Context, entity *domain.{{.Name}}) error {
	f.mu.Lock()
	defer f.mu.Unlock()
	if _, ok := f.items[entity.ID]; !ok {
		return domain.Err{{.Name}}NotFound
	}
	f.items[entity.ID] = *entity
	return nil
}

func (f *fake{{.Name}}Repository) Delete(_ context.Context, id string) error {
	f.mu.Lock()
	defer f.mu.Unlock()
	if _, ok := f.items[id]; !ok {
		return domain.Err{{.Name}}NotFound
	}
	delete(f.items, id)
	return nil
}

