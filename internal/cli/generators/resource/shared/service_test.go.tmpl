type fake{{.Name}}Repository struct {
	mu    sync.Mutex
	items map[string]domain.{{.Name}}
}

func newFake{{.Name}}Repository() *fake{{.Name}}Repository {
	return &fake{{.Name}}Repository{items: map[string]domain.{{.Name}}{}}
}

func (f *fake{{.Name}}Repository) Create(_ context.Context, entity *domain.{{.Name}}) error {
	f.mu.Lock()
	defer f.mu.Unlock()
	f.items[entity.ID] = *entity
	return nil
}

func (f *fake{{.Name}}Repository) List(_ context.Context, _ query.Result) ([]domain.{{.Name}}, int64, error) {
	f.mu.Lock()
	defer f.mu.Unlock()
	items := make([]domain.{{.Name}}, 0, len(f.items))
	for _, item := range f.items {
		items = append(items, item)
	}
	return items, int64(len(items)), nil
}

func (f *fake{{.Name}}Repository) Get(_ context.Context, id string) (domain.{{.Name}}, error) {
	f.mu.Lock()
	defer f.mu.Unlock()
	item, ok := f.items[id]
	if !ok {
		return domain.{{.Name}}{}, domain.Err{{.Name}}NotFound
	}
	return item, nil
}

func (f *fake{{.Name}}Repository) Update(_ context.Context, entity *domain.{{.Name}}) error {
	f.mu.Lock()
	defer f.mu.Unlock()
	if _, ok := f.items[entity.ID]; !ok {
		return domain.Err{{.Name}}NotFound
	}
	f.items[entity.ID] = *entity
	return nil
}

func (f *fake{{.Name}}Repository) Delete(_ context.Context, id string) error {
	f.mu.Lock()
	defer f.mu.Unlock()
	if _, ok := f.items[id]; !ok {
		return domain.Err{{.Name}}NotFound
	}
	delete(f.items, id)
	return nil
}

func Test{{.Name}}ServiceLifecycle(t *testing.T) {
	ctx := context.Background()
	svc := New{{.Name}}Service(newFake{{.Name}}Repository())

	created, err := svc.Create(ctx, dto.Create{{.Name}}Request{ {{range .StringFields}}{{.Pascal}}: "Sample value", {{end}} })
	if err != nil {
		t.Fatal(err)
	}
	if created.ID == "" || created.CreatedAt.IsZero() {
		t.Fatalf("created entity incomplete: %+v", created)
	}

	fetched, err := svc.Get(ctx, created.ID)
	if err != nil || fetched.ID != created.ID {
		t.Fatalf("get failed: %+v err=%v", fetched, err)
	}

	items, total, err := svc.List(ctx, query.Result{Page: 1, PerPage: 25})
	if err != nil || total != 1 || len(items) != 1 {
		t.Fatalf("list failed: total=%d err=%v", total, err)
	}

	if err := svc.Delete(ctx, created.ID); err != nil {
		t.Fatal(err)
	}
	if _, err := svc.Get(ctx, created.ID); !errors.Is(err, domain.Err{{.Name}}NotFound) {
		t.Fatalf("deleted entity still found: %v", err)
	}
}
